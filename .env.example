# ──────────────────────────────────────────
# Slugs Era — Environment Variables Template
# Copy this to .env and fill in your real values
# NEVER commit .env to version control
# ──────────────────────────────────────────

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# SMTP (for welcome emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
CONTACT_EMAIL=hello@slugsera.com

# Server
ALLOWED_ORIGIN=http://localhost:5173
PORT=3000

# VITE_ prefixed variables are exposed to the frontend
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Google Analytics (leave blank to disable)
VITE_GA4_MEASUREMENT_ID=
